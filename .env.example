# Copy to .env and fill in. NEVER commit .env (it is gitignored from the first commit).

# --- Server ---
PORT=4317
NODE_ENV=development

# --- Persistence (SQLite via node:sqlite, no Docker needed) ---
DATABASE_PATH=./db/app.sqlite

# --- Multi-tenancy (isolated rows; default tenant seeded) ---
TENANT_ID=default

# --- Vision provider: "fixture" (pre-generated, schema-validated JSON — the FlyRank-blessed $0 path)
#     or "gemini" (live Google AI Studio calls; requires GEMINI_API_KEY) ---
VISION_PROVIDER=fixture
GEMINI_API_KEY=

# --- Embedding provider: "hf" (Hugging Face Inference API, free token) or "cache" (committed vectors, keyless) ---
EMBEDDING_PROVIDER=cache
HF_TOKEN=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Guard thresholds (tuned on the labeled eval set; see README) ---
SIMILARITY_THRESHOLD=0.55
LOW_CONFIDENCE_THRESHOLD=0.60

# --- Cost control ---
COST_BUDGET_USD=1.00

# --- Optional failure alert webhook for the background job (leave empty to log only) ---
WEBHOOK_ALERT_URL=
